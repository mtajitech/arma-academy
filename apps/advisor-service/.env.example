# ─── advisor-service Environment Variables ───────────────────────────────
NODE_ENV=production
PORT=3006
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/arma_advisor_service

# Redis
REDIS_URL=redis://localhost:6379

# JWT (set in auth-service, verified in all services)
JWT_SECRET=replace_with_secure_random_string
JWT_EXPIRES_IN=3600

# API Gateway
API_GATEWAY_URL=http://api-gateway:3000

# Monitoring
SENTRY_DSN=
METRICS_PORT=9090
